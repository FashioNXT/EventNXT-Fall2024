<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4" style="background-color: #f8f9fa; border-radius: 10px;">
          <h2 class="text-center mb-4" style="color: #2c3e50;">Log in to <%= Constants::EVENTS360::NAME %></h2>

          <%= form_for(resource, as: resource_name, url: user_session_path) do |f| %>
            <div class="mb-3">
              <%= f.label :email, class: "form-label fw-bold" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "email@example.com" %>
            </div>

            <div class="mb-3">
              <%= f.label :password, class: "form-label fw-bold" %>
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "••••••••" %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="mb-3 form-check">
                <%= f.check_box :remember_me, class: "form-check-input" %>
                <%= f.label :remember_me, class: "form-check-label" %>
              </div>
            <% end %>

            <div class="d-grid gap-2 mt-4">
              <%= f.submit "Sign In", class: "btn btn-success btn-lg" %>
            </div>
          <% end %>

          <div class="mt-4 text-center border-top pt-3">
            <%= link_to "← Back to Portal", Constants::EVENTS360::URL, class: "text-decoration-none text-secondary small" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>