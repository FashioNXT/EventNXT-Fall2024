<div style="display: flex; justify-content: center; align-items: center; min-height: 100vh; background: #1a1a2e; font-family: sans-serif;">
  <div style="background: white; padding: 40px; border-radius: 20px; box-shadow: 0 15px 35px rgba(0,0,0,0.2); width: 100%; max-width: 400px;">
    <h2 style="text-align: center; color: #333; margin-bottom: 30px;">Events360 Login</h2>
    
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div style="margin-bottom: 20px;">
        <%= f.label :email, style: "display: block; margin-bottom: 5px; color: #666;" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", style: "width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box;" %>
      </div>

      <div style="margin-bottom: 25px;">
        <%= f.label :password, style: "display: block; margin-bottom: 5px; color: #666;" %>
        <%= f.password_field :password, autocomplete: "current-password", style: "width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box;" %>
      </div>

      <div style="margin-bottom: 20px;">
        <%= f.submit "Enter Portal", style: "width: 100%; padding: 15px; background: #63cc82; color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 1rem;" %>
      </div>
    <% end %>
    
    <div style="text-align: center; margin-top: 20px;">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
